# ==============================================================================
# Sakan (سكن) — Environment Configuration Template
# ==============================================================================
# `docker compose up` works out-of-the-box without a `.env` file using the
# DEV ONLY defaults below. To customize locally, copy this file to `.env`:
#   cp .env.example .env
#
# IMPORTANT: Every value below marked [DEV ONLY] or [SECRET] MUST be replaced
# with a strong secret in staging/production environments. Never commit `.env`.

# --- Database (PostgreSQL / PostGIS container & Spring Datasource) ------------
# Used by docker-compose.yml to initialize `db` and construct SPRING_DATASOURCE_*
DB_NAME=sakan
DB_USER=sakan
# [SECRET] [DEV ONLY] Database password (passed to POSTGRES_PASSWORD and SPRING_DATASOURCE_PASSWORD)
DB_PASSWORD=change_me

# --- Host Port Mappings (change if a port is already in use on your machine) --
DB_PORT=5433
API_PORT=8080
WEB_PORT=4200

# --- Authentication & Security (SCRUM-51) -------------------------------------
# [SECRET] [DEV ONLY] HMAC signing key for JWT tokens (use >= 32 random chars in production)
JWT_SECRET=dev-only-jwt-secret-change-in-production-min-32-chars

# [DEV ONLY] Seeded administrator account credentials
ADMIN_USERNAME=admin
# [SECRET] [DEV ONLY]
ADMIN_PASSWORD=change_me

# --- Google OAuth2 Login (optional in local dev) ------------------------------
GOOGLE_CLIENT_ID=
# [SECRET]
GOOGLE_CLIENT_SECRET=
